{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoupeCam",
  "identifier": "io.github.cinderblock.loupecam",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "bun run --cwd ../web build",
    "beforeBuildCommand": "bun run --cwd ../web build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMUZENzA2Nzc1MkIxM0UKUldRK3NWSjNCdGNmWVp0NFNuQ2h1d1NjWTFaSHJOODNrd1RmWkNtRzdQaFI2bDF2SWtkRzJYM1oK",
      "endpoints": [
        "https://github.com/cinderblock/loupecam/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
