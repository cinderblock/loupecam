# LoupeCam headless server. Installed by install.sh; settings live in
# /etc/loupecam/loupecam.env (listen address, token, extra arguments).
[Unit]
Description=LoupeCam microscope camera server
Documentation=https://github.com/cinderblock/loupecam
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=loupecam
Group=loupecam
SupplementaryGroups=plugdev
Environment=LOUPECAM_LISTEN=0.0.0.0:80
EnvironmentFile=-/etc/loupecam/loupecam.env
# Settings and calibration (dirs::config_dir) land in /var/lib/loupecam/config.
Environment=XDG_CONFIG_HOME=/var/lib/loupecam/config
ExecStart=/opt/loupecam/loupecam serve --listen ${LOUPECAM_LISTEN} --web-ui embedded --captures /var/lib/loupecam/captures $LOUPECAM_ARGS
Restart=always
RestartSec=2

StateDirectory=loupecam
# Self-update replaces the binary in place, then execs it (same PID).
ReadWritePaths=/opt/loupecam
# USB sticks for captures are automounted below here (99-loupecam-usb.rules).
ReadWritePaths=-/media/loupecam

# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Only the camera: USB device nodes (major 189), present or hot-plugged later.
DevicePolicy=closed
DeviceAllow=char-usb_device rw

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022

[Install]
WantedBy=multi-user.target
