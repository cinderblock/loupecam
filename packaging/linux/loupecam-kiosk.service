# LoupeCam touchscreen kiosk: the fullscreen UI on the display attached to this
# machine (e.g. the Raspberry Pi 7" touch display). Installed by `install.sh --kiosk`.
#
# It runs in a login session on tty1 (instead of the console login there), which gives
# it the display, and lets `cage` + Chromium take over the screen for casts it can't
# show natively. Settings: /etc/loupecam/kiosk.env (rotation, sleep, home screen); the
# server's tokens come from /etc/loupecam/loupecam.env.
[Unit]
Description=LoupeCam touchscreen kiosk
Documentation=https://github.com/cinderblock/loupecam
Wants=loupecam.service
After=loupecam.service systemd-user-sessions.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=loupecam-kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/loupecam/loupecam.env
EnvironmentFile=-/etc/loupecam/kiosk.env
StateDirectory=loupecam-kiosk
Environment=LOUPECAM_KIOSK_BROWSER_PROFILE=/var/lib/loupecam-kiosk/chromium
ExecStart=/opt/loupecam/loupecam kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
